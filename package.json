{
  "name": "bd-hub",
  "version": "0.1.0",
  "type": "module",
  "description": "Real-time kanban dashboard for the bd (beads) issue tracker",
  "keywords": [
    "beads",
    "bd",
    "kanban",
    "dashboard",
    "issue-tracker",
    "real-time",
    "lit",
    "hono"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bd-hub": "dist/server/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist/server/index.js --packages=external",
    "postbuild": "node -e \"const fs=require('fs'),f='dist/server/index.js',b=fs.readFileSync(f,'utf8');fs.writeFileSync(f,'#!/usr/bin/env node\\n'+b);fs.chmodSync(f,0o755)\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@lit/context": "^1.1.6",
    "chokidar": "^5.0.0",
    "execa": "^9.6.1",
    "hono": "^4.12.21",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ]
  }
}
