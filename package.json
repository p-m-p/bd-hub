{
  "name": "bd-hub",
  "version": "0.4.0",
  "type": "module",
  "description": "Real-time kanban dashboard for the bd (beads) issue tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/p-m-p/bd-hub"
  },
  "keywords": [
    "beads",
    "bd",
    "kanban",
    "dashboard",
    "issue-tracker",
    "real-time",
    "lit",
    "hono"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bd-hub": "dist/server/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "generate-tokens": "node scripts/generate-tokens.mjs",
    "dev": "concurrently \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist/server/index.js --packages=external",
    "postbuild": "node -e \"const fs=require('fs'),f='dist/server/index.js',b=fs.readFileSync(f,'utf8');fs.writeFileSync(f,'#!/usr/bin/env node\\n'+b);fs.chmodSync(f,0o755)\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "release": "pnpm build && changeset publish",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@lit/context": "^1.1.6",
    "@types/markdown-it": "^14.1.2",
    "@types/prismjs": "^1.26.6",
    "catppuccin-prismjs": "github:catppuccin/prismjs",
    "chokidar": "^5.0.0",
    "execa": "^9.6.1",
    "hono": "^4.12.21",
    "lit": "^3.3.3",
    "markdown-it": "^14.2.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@catppuccin/palette": "^1.8.0",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^10.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@11.8.0"
}
